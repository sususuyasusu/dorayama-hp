# dorayama.com（さくらのレンタルサーバ）用
# http と www 付きは https://dorayama.com へまとめる（検索の評価を1つに集める）
RewriteEngine On
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{HTTP_HOST} ^(www\.)?dorayama\.com$ [NC]
RewriteCond %{HTTP:X-Sakura-Forwarded-For} ^$ [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://dorayama.com/$1 [R=301,L]

ErrorDocument 404 /404.html

# 名前に版番号が入るファイルは長く覚えさせ、ページ本体は毎回確認させる
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
